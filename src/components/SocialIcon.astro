---
// Simple glyphs drawn in the folk line style (not the platforms' official logos).
import type { Platform } from "../data/site";
interface Props { id: Platform; class?: string }
const { id, class: cls = "ico" } = Astro.props;
---
<svg class={cls} viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
  {id === "youtube" && (<><rect x="3" y="7" width="26" height="18" rx="6" /><path d="M13.5 11.5 L21 16 L13.5 20.5 Z" fill="currentColor" /></>)}
  {id === "tiktok" && (<><path d="M18 5 V20.5 A4.5 4.5 0 1 1 13.5 16" /><path d="M18 5 C18.5 8.5 21 10.5 25 10.8" /></>)}
  {id === "instagram" && (<><rect x="5" y="5" width="22" height="22" rx="6.5" /><circle cx="16" cy="16" r="5" /><circle cx="22.6" cy="9.4" r="1.2" fill="currentColor" stroke="none" /></>)}
  {id === "facebook" && (<><circle cx="16" cy="16" r="12" /><path d="M17 28 V14.5 A3.5 3.5 0 0 1 20.5 11 H21.5 M13.5 18 H20.5" /></>)}
</svg>
