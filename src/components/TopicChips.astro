---
// Topic filter for the home page video grid. Buttons filter in place; #topic-<id> links (footer,
// video pages, old /topics/ URLs) pick a topic on arrival. Without JS every video stays visible.
import { TOPICS } from "../data/site";
import T from "./T.astro";
---
<ul class="chips" aria-label="विषय · Topics">
  <li><button type="button" class="chip" data-filter="all" aria-pressed="true"><T ne="सबै" en="All" mix="सबै" /></button></li>
  {TOPICS.map((t) => (
    <li><button type="button" class={`chip ${t.id}`} data-filter={t.id} aria-pressed="false"><T ne={t.ne} en={t.en} mix={t.mix} /></button></li>
  ))}
</ul>
<script>
  const apply = (topic: string) => {
    document.querySelectorAll<HTMLElement>("[data-topic-item]").forEach((el) => {
      el.hidden = topic !== "all" && el.dataset.topicItem !== topic;
    });
    document.querySelectorAll<HTMLElement>("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === topic)));
  };
  document.addEventListener("click", (e) => {
    const b = (e.target as Element | null)?.closest?.<HTMLElement>("[data-filter]");
    if (!b) return;
    apply(b.dataset.filter!);
    history.replaceState(null, "", b.dataset.filter === "all" ? "#videos" : `#topic-${b.dataset.filter}`);
  });
  const fromHash = () => {
    const m = location.hash.match(/^#topic-([a-z]+)$/);
    if (!m || !document.querySelector("[data-filter]")) return;
    apply(m[1]);
    document.getElementById("videos")?.scrollIntoView();
  };
  document.addEventListener("astro:page-load", fromHash);
  window.addEventListener("hashchange", fromHash);
</script>
