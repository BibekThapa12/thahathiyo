---
import { SOCIALS } from "../data/site";
import SocialIcon from "./SocialIcon.astro";
import T from "./T.astro";
interface Props { compact?: boolean; label?: string }
const { compact = false, label = "Follow" } = Astro.props;
---
<ul class:list={["follow", { compact }]} aria-label={label}>
  {SOCIALS.map((s) => (
    <li class={s.id}>
      <a class={`btn ${s.id}`} href={s.id === "youtube" && !compact ? `${s.url}?sub_confirmation=1` : s.url} target="_blank" rel="noopener me" aria-label={compact ? `${s.name} @thahathiyo` : undefined}>
        <SocialIcon id={s.id} />
        {!compact && (s.id === "youtube"
          ? <span><T ne={`${s.nameNe}मा फलो गर्नुहोस्`} en={`Follow on ${s.name}`} mix={`${s.name} मा Follow गर्नुस्`} /></span>
          : <span><T ne={s.nameNe} en={s.name} mix={s.name} /><small><T ne="फलो" en="Follow" mix="Follow" /></small></span>)}
      </a>
    </li>
  ))}
</ul>
<style>
  /* YouTube leads full width; the other three sit in one smaller row. */
  .follow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 560px;
  }
  .follow li.youtube {
    grid-column: 1 / -1;
  }
  .follow .btn {
    width: 100%;
    height: 100%;
  }
  .follow li:not(.youtube) .btn {
    flex-direction: column;
    gap: 2px;
    padding: 8px 6px;
    border-radius: 18px;
    text-align: center;
    font-size: 0.92rem;
  }
  .follow:not(.compact) li.youtube .btn {
    min-height: 60px;
    font-size: 1.15rem;
    justify-content: center;
  }
  .follow.compact {
    display: flex;
    gap: 8px;
  }
  .follow.compact li.youtube {
    grid-column: auto;
  }
  .follow.compact .btn,
  .follow.compact li:not(.youtube) .btn {
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    flex-direction: row;
    justify-content: center;
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .follow.compact .btn.tiktok {
    box-shadow: 3px 3px 0 var(--gold);
  }
  .follow.compact .ico {
    width: 24px;
    height: 24px;
  }
</style>
