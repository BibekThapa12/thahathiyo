---
import { LogoMark } from "./art/scenes";
import FollowButtons from "./FollowButtons.astro";
import { u } from "../lib/url";
import T from "./T.astro";
const nav = [
  { href: "#videos", ne: "भिडियो", en: "Videos", mix: "Videos" },
  { href: "#about", ne: "हाम्रो बारेमा", en: "About", mix: "हाम्रो About" },
  { href: "#support", ne: "चिया", en: "Support", mix: "चिया Support" },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={u("")} aria-label="थाहा थियो? गृहपृष्ठ | Home">
      <LogoMark size={46} />
      <span class="word">थाहा थियो?<small>Thaha Thiyo</small></span>
    </a>
    <nav aria-label="मुख्य | Main">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={u(n.href)}>
              <T ne={n.ne} en={n.en} mix={n.mix} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="lang" role="group" aria-label="भाषा · Language">
      <button type="button" data-set-lang="ne" aria-pressed="true">नेपाली</button>
      <button type="button" data-set-lang="en" aria-pressed="false" lang="en">English</button>
      <button type="button" data-set-lang="mix" aria-pressed="false">नेपा-Eng</button>
    </div>
    <div class="socials"><FollowButtons compact label="Follow @thahathiyo" /></div>
  </div>
  <div class="tri"></div>
</header>
<style>
  .site-header {
    background: var(--cream);
    border-bottom: var(--line) solid var(--ink);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-right: auto;
  }
  .word {
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1;
    color: var(--vermilion-2);
  }
  .word small {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    margin-top: 2px;
  }
  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 10px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    border: 3px solid transparent;
  }
  nav a {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* language switch: one pill, the active language filled gold */
  .lang {
    display: flex;
    border: 2px solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
    background: #fffaf0;
  }
  .lang button {
    all: unset;
    cursor: pointer;
    min-height: 44px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    font: 800 0.85rem/1 var(--font);
  }
  .lang button + button {
    border-left: 2px solid var(--ink);
  }
  .lang button[aria-pressed="true"] {
    background: var(--gold);
  }
  .lang button:focus-visible {
    outline: 3px solid var(--indigo);
    outline-offset: -5px;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    border-color: var(--ink);
    background: var(--gold);
  }
  .tri {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -22px;
  }
  @media (max-width: 719px) {
    .site-header {
      position: relative;
    }
    nav a {
      padding: 4px 6px;
    }
    .socials {
      display: none;
    }
    nav {
      order: 3;
      width: 100%;
    }
    nav ul {
      justify-content: space-between;
    }
    nav li {
      flex: 1;
    }
    .bar {
      gap: 6px;
    }
  }
</style>
