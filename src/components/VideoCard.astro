---
import type { Video } from "../lib/videos";
import { platformLinks, topicOf } from "../lib/videos";
import SocialIcon from "./SocialIcon.astro";
import { dateEn, dateNe, ne } from "../lib/format";
import T from "./T.astro";
import { VideoArt } from "./art/scenes";
import { u } from "../lib/url";
interface Props { video: Video; eager?: boolean }
const { video: v, eager = false } = Astro.props;
const t = topicOf(v.topic);
const join = (...p: (string | false)[]) => p.filter(Boolean).join(" · ");
const meta = {
  ne: join(`#${ne(v.number)}`, t.ne, !!v.date && dateNe(v.date)),
  en: join(`#${v.number}`, t.en, !!v.date && dateEn(v.date)),
  mix: join(`#${ne(v.number)}`, t.mix, !!v.date && dateNe(v.date)),
};
---
<article class="vcard">
  <a href={u(`videos/${v.slug}/`)} class="link">
    <div class="thumb">
      <VideoArt art={v.art} label="" />
      {v.thumbnail && <img src={v.thumbnail} alt="" width="1080" height="1920" loading={eager ? "eager" : "lazy"} decoding="async" onerror="this.remove()" />}
      {v.status === "coming-soon" && <span class="soon"><T ne="छिट्टै आउँदैछ" en="Coming soon" mix="Coming soon!" /></span>}
    </div>
    <h3>{v.titleEn || v.titleNe}</h3>
    <p class="meta"><T {...meta} /></p>
  </a>
  {platformLinks(v).length > 0 && (
    <ul class="apps" aria-label={`${v.titleEn || v.titleNe}: apps`}>
      {platformLinks(v).map((l) => <li><a class={l.id} href={l.url} target="_blank" rel="noopener" aria-label={l.name} title={l.name}><SocialIcon id={l.id} /></a></li>)}
    </ul>
  )}
</article>
<style>
  /* One card style site-wide: cream card, ink border; thumbnail framed inside, title/meta/apps below */
  .vcard {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 10px 10px 4px;
    background: #fffaf0;
    border: 2px solid var(--ink);
    border-radius: 16px;
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  /* lift on hover only for real pointers; on touch the card presses in instead */
  @media (hover: hover) and (pointer: fine) {
    .vcard:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--ink);
    }
  }
  .vcard:has(.link:active) {
    transform: scale(0.98);
    transition-duration: 120ms;
  }
  .link {
    display: block;
    text-decoration: none;
  }
  .thumb {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--indigo);
    border: 2px solid var(--ink);
    border-radius: 10px;
    overflow: hidden;
  }
  .thumb img,
  .thumb :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .soon {
    position: absolute;
    left: 8px;
    bottom: 8px;
    background: var(--vermilion);
    color: #fff;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 0.8rem;
    font-weight: 800;
  }
  h3 {
    font-size: 1rem;
    line-height: 1.3;
    margin: 10px 0 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* direct links to this video on each app; 40px hit areas so four fit a phone card */
  .apps {
    list-style: none;
    display: flex;
    margin: auto 0 0 -8px; /* auto: icons sit at the card bottom so rows line up */
    padding: 0;
  }
  .apps a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background-color 150ms ease, transform 120ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .apps a:hover {
      background: var(--cream-2);
    }
  }
  .apps a:active {
    transform: scale(0.92);
  }
  .apps :global(.ico) {
    width: 22px;
    height: 22px;
  }
  .apps .youtube { color: var(--vermilion); }
  .apps .tiktok { color: var(--ink); }
  .apps .instagram { color: #c13584; }
  .apps .facebook { color: var(--indigo-2); }
  .meta {
    margin: 0;
    font-size: 0.82rem;
    opacity: 0.75;
  }
</style>
