---
// One piece of text in three languages; html[data-lang] (set by the header switch) shows one.
// Missing English or NepEnglish falls back to Nepali.
interface Props { ne: string; en?: string; mix?: string }
const { ne, en, mix } = Astro.props;
---
<span class="l-ne">{ne}</span><span class="l-en" lang={en ? "en" : undefined}>{en || ne}</span><span class="l-mix">{mix || ne}</span>
