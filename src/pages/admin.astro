---
// Video editor for the channel owner: edits src/data/videos.json on GitHub (each save is a commit,
// Vercel redeploys). No server: the browser talks to the GitHub API with the owner's own token.
import "../styles/global.css";
import SocialIcon from "../components/SocialIcon.astro";
import { TOPICS, type Platform } from "../data/site";
import { u } from "../lib/url";

const LINKS: { id: Platform; key: string; name: string; eg: string }[] = [
  { id: "youtube", key: "youtubeId", name: "YouTube", eg: "https://youtube.com/shorts/…" },
  { id: "tiktok", key: "tiktokUrl", name: "TikTok", eg: "https://www.tiktok.com/@thahathiyo/video/…" },
  { id: "instagram", key: "instagramUrl", name: "Instagram", eg: "https://www.instagram.com/reel/…" },
  { id: "facebook", key: "facebookUrl", name: "Facebook", eg: "https://www.facebook.com/reel/…" },
];
const ARTS = ["mascot", "crow", "dog", "diya", "lake", "flag", "calendar", "cans"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit videos | थाहा थियो?</title>
    <link rel="icon" href={u("favicon-32.png")} type="image/png" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={u("")}>थाहा थियो? <span>videos</span></a>
      <div class="top-links">
        <nav class="tabs" id="tabs" aria-label="Dashboard" hidden>
          <button class="link-btn tab" type="button" data-tab="list">Videos</button>
          <button class="link-btn tab" type="button" data-tab="stats">Stats</button>
        </nav>
        <a class="link-btn" href={u("")}>Homepage</a>
        <button class="link-btn" id="signout" type="button" hidden>Sign out</button>
      </div>
    </header>

    <main class="wrap">
      <!-- 1. sign in -->
      <section id="signin" hidden>
        <h1>Sign in to edit your videos</h1>
        <p class="lead">You need a GitHub key once. Your browser remembers it after that.</p>
        <ol class="steps">
          <li><a class="btn ghost" id="make-key" href="https://github.com/settings/personal-access-tokens/new?name=Thaha+Thiyo+admin&contents=write" target="_blank" rel="noopener">Create a key on GitHub ↗</a></li>
          <li>On that page, under <b>Repository access</b>, choose <b>Only select repositories</b> → <b>thahathiyo</b>. Then press <b>Generate token</b> and copy it.</li>
          <li>
            <form id="signin-form" class="row">
              <label class="sr" for="token">GitHub key</label>
              <input id="token" type="password" autocomplete="off" placeholder="Paste the key here" required />
              <button class="btn" type="submit">Sign in</button>
            </form>
          </li>
        </ol>
        <p class="msg" id="signin-msg" role="alert"></p>
      </section>

      <!-- 2. list -->
      <section id="list" hidden>
        <div class="list-head">
          <h1>Your videos</h1>
          <button class="btn" id="add" type="button">+ Add a video</button>
        </div>
        <p class="msg" id="list-msg" role="status"></p>
        <ul class="videos" id="videos"></ul>
      </section>

      <!-- 3. edit -->
      <section id="edit" hidden>
        <button class="link-btn back" id="back" type="button">← All videos</button>
        <h1 id="edit-h">New video</h1>
        <div class="import">
          <label class="btn ghost small import-btn">
            Import from MD file
            <input id="md-file" class="sr" type="file" accept=".md,.markdown,.txt,text/markdown,text/plain" />
          </label>
          <span class="hint">Fills the title, description, facts and sources from the video's .md file. You can also drop the file anywhere on this page.</span>
        </div>
        <p class="msg" id="import-msg" role="status"></p>
        <form id="form" novalidate>
          <fieldset>
            <legend>About the video</legend>
            <label>Title<input name="titleEn" required placeholder="Same as on YouTube" /></label>
            <div class="two">
              <label>Video number<input name="number" type="number" min="1" required /></label>
              <label>Upload date<input name="date" type="date" /></label>
            </div>
            <div class="label">Topic</div>
            <div class="chips" role="radiogroup" aria-label="Topic">
              {TOPICS.map((t) => <label class="topic"><input type="radio" name="topic" value={t.id} required /><span>{t.en}</span></label>)}
            </div>
            <label>Description<textarea name="descriptionEn" rows="5" placeholder="One or two sentences about the video"></textarea></label>
          </fieldset>

          <fieldset>
            <legend>Where to watch it</legend>
            <p class="hint">Paste each app's link. Leave YouTube empty until it's uploaded: the site shows “Coming soon”.</p>
            {LINKS.map((l) => (
              <label class="link-field">
                <span class={`ico-wrap ${l.id}`}><SocialIcon id={l.id} /></span>
                <span class="sr">{l.name} link</span>
                <input name={l.key} type="url" inputmode="url" placeholder={l.eg} />
              </label>
            ))}
          </fieldset>

          <fieldset>
            <legend>Facts</legend>
            <ol class="rows" id="facts"></ol>
            <button class="btn ghost small" id="add-fact" type="button">+ Add a fact</button>
          </fieldset>

          <fieldset>
            <legend>Sources</legend>
            <ol class="rows" id="sources"></ol>
            <button class="btn ghost small" id="add-source" type="button">+ Add a source</button>
          </fieldset>

          <details class="more">
            <summary>More options</summary>
            <label>Nepali title<input name="titleNe" /></label>
            <label>Nepali description<textarea name="description" rows="3"></textarea></label>
            <label>Page address<input name="slug" placeholder="made from the title" /></label>
            <p class="hint">Don't change the page address after a video is live: old links would stop working.</p>
            <label>Picture if the thumbnail can't load
              <select name="art"><option value="">Mascot (default)</option>{ARTS.slice(1).map((a) => <option value={a}>{a}</option>)}</select>
            </label>
            <label>Title keywords<input name="matchTitle" placeholder="e.g. Tihar, Kag" /></label>
            <p class="hint">Only for “Coming soon” videos: words from the future YouTube title, comma-separated, so the upload links up by itself.</p>
          </details>

          <div class="savebar">
            <button class="btn" id="save" type="submit">Save</button>
            <p class="msg" id="save-msg" role="status"></p>
            <button class="link-btn danger" id="delete" type="button" hidden>Delete video</button>
          </div>
        </form>
      </section>
      <!-- 4. website stats (Vercel Web Analytics API) -->
      <section id="stats" hidden>
        <div class="list-head">
          <h1>Website stats</h1>
          <div class="range" role="group" aria-label="Date range">
            <button type="button" class="range-btn" data-days="7" aria-pressed="true">7 days</button>
            <button type="button" class="range-btn" data-days="30" aria-pressed="false">30 days</button>
          </div>
        </div>
        <p class="hint">Your own visits aren't counted: signing in here marks this browser as yours.</p>

        <div id="vc-connect" hidden>
          <p class="lead">Connect Vercel once to see your visitors here. Your browser remembers it after that.</p>
          <ol class="steps">
            <li><a class="btn ghost" href="https://vercel.com/account/settings/tokens" target="_blank" rel="noopener">Create a Vercel token ↗</a></li>
            <li>Name it <b>Thaha dashboard</b>, pick the scope that holds the <b>thahathiyo</b> project, set an expiry, then press <b>Create</b> and copy it.</li>
            <li>
              <form id="vc-form" class="row">
                <label class="sr" for="vc-token">Vercel token</label>
                <input id="vc-token" type="password" autocomplete="off" placeholder="Paste the Vercel token here" required />
                <button class="btn" type="submit">Connect</button>
              </form>
            </li>
          </ol>
        </div>

        <p class="msg" id="stats-msg" role="status"></p>

        <div id="stats-body" hidden>
          <div class="tiles">
            <div class="tile"><span class="tile-n" id="t-visitors">–</span><span class="tile-l" id="t-visitors-l">Visitors</span></div>
            <div class="tile"><span class="tile-n" id="t-views">–</span><span class="tile-l">Page views</span></div>
            <div class="tile"><span class="tile-n small" id="t-source">–</span><span class="tile-l">Top source</span></div>
          </div>

          <div class="card">
            <h2>Page views per day</h2>
            <div class="chart">
              <span class="ymax" id="ymax"></span>
              <div class="bars" id="daily"></div>
              <div class="tip" id="tip" role="tooltip" hidden></div>
            </div>
            <div class="xlabels" id="xlabels"></div>
            <details class="table-view"><summary>Show as table</summary><table><thead><tr><th>Day</th><th>Page views</th><th>Visitors</th></tr></thead><tbody id="daily-table"></tbody></table></details>
          </div>

          <div class="grid2">
            <div class="card"><h2>Most viewed pages</h2><ol class="rank" id="r-pages"></ol></div>
            <div class="card"><h2>Where visitors come from</h2><ol class="rank" id="r-refs"></ol></div>
            <div class="card"><h2>Countries</h2><ol class="rank" id="r-countries"></ol></div>
            <div class="card"><h2>Devices</h2><ol class="rank" id="r-devices"></ol></div>
          </div>
          <button class="link-btn" id="vc-disconnect" type="button">Disconnect Vercel</button>
        </div>
      </section>
    </main>

    {LINKS.map((l) => <template id={`ico-${l.id}`}><SocialIcon id={l.id} /></template>)}
  </body>
</html>

<script>
  import { dateEn, todayNepal } from "../lib/format";
  import { parseVideoMd, cleanLink, cleanTitle } from "../lib/videoMd";

  type Entry = Record<string, any> & { slug: string; number: number; titleEn: string };
  const REPO = "BibekThapa12/thahathiyo";
  const FILE = "src/data/videos.json";
  const API = `https://api.github.com/repos/${REPO}/contents/${FILE}`;
  const KEY = "thaha-admin-token";
  const PLATFORMS = [["youtube", "youtubeId"], ["tiktok", "tiktokUrl"], ["instagram", "instagramUrl"], ["facebook", "facebookUrl"]] as const;

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
  const form = $<HTMLFormElement>("#form");
  let token = "";
  let videos: Entry[] = [];
  let editing: Entry | null = null; // null = new video
  let dirty = false;

  const store = {
    get: () => { try { return localStorage.getItem(KEY) ?? ""; } catch { return ""; } },
    set: (v: string) => { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); } catch {} },
  };
  const ytId = (s = "") => s.match(/(?:shorts\/|v=|youtu\.be\/|embed\/)([\w-]{11})/)?.[1] ?? s.trim();
  const slugify = (s: string) => s.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60);
  const b64 = {
    decode: (s: string) => new TextDecoder().decode(Uint8Array.from(atob(s.replace(/\n/g, "")), (c) => c.charCodeAt(0))),
    encode: (s: string) => { let bin = ""; new TextEncoder().encode(s).forEach((b) => (bin += String.fromCharCode(b))); return btoa(bin); },
  };

  function show(id: "signin" | "list" | "edit" | "stats") {
    for (const s of ["signin", "list", "edit", "stats"]) $("#" + s).hidden = s !== id;
    $("#signout").hidden = $("#tabs").hidden = id === "signin";
    const tab = id === "stats" ? "stats" : "list";
    document.querySelectorAll<HTMLElement>(".tab").forEach((t) => t.toggleAttribute("aria-current", t.dataset.tab === tab));
    scrollTo(0, 0);
  }
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, any> = {}, ...kids: (Node | string)[]) {
    const n = Object.assign(document.createElement(tag), props);
    n.append(...kids);
    return n;
  }

  // ---- GitHub ----
  class GhError extends Error {}
  async function gh(init?: RequestInit) {
    const res = await fetch(API + (init ? "" : "?ref=main"), {
      ...init,
      cache: "no-store",
      headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json", ...(init?.headers ?? {}) },
    });
    if (res.status === 401) throw new GhError("That key didn't work. It may be mistyped or expired: create a new one with step 1.");
    if (res.status === 403 || res.status === 404) throw new GhError("The key can't open the thahathiyo repository. On GitHub, edit the key: give it access to thahathiyo with Contents set to “Read and write”.");
    if (res.status === 409 || res.status === 422) throw Object.assign(new GhError("conflict"), { conflict: true });
    if (!res.ok) throw new GhError(`GitHub said “${res.status} ${res.statusText}”. Try again in a minute.`);
    return res.json();
  }
  async function load(): Promise<{ list: Entry[]; sha: string }> {
    const j = await gh();
    return { list: JSON.parse(b64.decode(j.content)), sha: j.sha };
  }
  // Re-reads the file right before writing, so a commit made meanwhile (e.g. the daily YouTube save) isn't lost.
  async function commit(change: (list: Entry[]) => Entry[], message: string) {
    for (let attempt = 0; ; attempt++) {
      const { list, sha } = await load();
      const next = change(list).sort((a, b) => a.number - b.number);
      try {
        await gh({ method: "PUT", body: JSON.stringify({ message, sha, branch: "main", content: b64.encode(JSON.stringify(next, null, 2) + "\n") }) });
        videos = next;
        return;
      } catch (e: any) {
        if (!e.conflict || attempt) throw e;
      }
    }
  }

  // ---- sign in ----
  async function start() {
    token = store.get();
    if (!token) return show("signin");
    $("#list-msg").textContent = "Loading…";
    show("list");
    try {
      videos = (await load()).list;
      try { localStorage.setItem("thaha-no-track", "1"); } catch {} // the site's analytics skips this browser (Base.astro)
      $("#list-msg").textContent = "";
      renderList();
    } catch (e: any) {
      store.set("");
      token = "";
      show("signin");
      $("#signin-msg").textContent = e.message;
    }
  }
  $("#signin-form").addEventListener("submit", (e) => {
    e.preventDefault();
    store.set($<HTMLInputElement>("#token").value.trim());
    $("#signin-msg").textContent = "";
    start();
  });
  $("#signout").addEventListener("click", () => {
    if (dirty && !confirm("You have unsaved changes. Sign out anyway?")) return;
    dirty = false;
    store.set("");
    $<HTMLInputElement>("#token").value = "";
    show("signin");
  });

  // ---- list ----
  function renderList() {
    const ul = $("#videos");
    ul.replaceChildren();
    for (const v of [...videos].sort((a, b) => b.number - a.number)) {
      const id = ytId(v.youtubeId);
      const thumb = el("span", { className: "thumb" });
      if (id) thumb.append(el("img", { src: `https://i.ytimg.com/vi/${id}/oar2.jpg`, alt: "", loading: "lazy", onerror: function (this: HTMLImageElement) { this.remove(); } }));
      const apps = el("span", { className: "apps" });
      const missing: string[] = [];
      for (const [p, k] of PLATFORMS) {
        const has = !!v[k]?.trim();
        if (!has) missing.push(p[0].toUpperCase() + p.slice(1));
        const icon = ($<HTMLTemplateElement>(`#ico-${p}`).content.cloneNode(true) as DocumentFragment);
        apps.append(el("span", { className: `app ${p}${has ? "" : " off"}` }, icon));
      }
      const facts = v.facts?.length ?? 0, sources = v.sources?.length ?? 0;
      const status = !id ? "Coming soon" : missing.length ? `Missing: ${missing.join(", ")}` : "All links added";
      const btn = el("button", { type: "button", className: "vrow" },
        thumb,
        el("span", { className: "vtext" },
          el("span", { className: "vmeta" }, `#${v.number}${v.date ? " · " + dateEn(v.date) : ""}`),
          el("span", { className: "vtitle" }, v.titleEn || v.titleNe || "Untitled"),
          el("span", { className: `vstatus${!id || missing.length ? " warn" : ""}` }, `${status} · ${facts} fact${facts === 1 ? "" : "s"} · ${sources} source${sources === 1 ? "" : "s"}`),
        ),
        apps,
      );
      btn.addEventListener("click", () => openEditor(v));
      ul.append(el("li", {}, btn));
    }
  }
  $("#add").addEventListener("click", () => openEditor(null));

  // ---- editor ----
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;

  function factRow(f: { en: string; ne?: string } = { en: "" }) {
    const ta = el("textarea", { rows: 2, value: f.en, placeholder: "One fact from the video", ariaLabel: "Fact" });
    const li = el("li", { className: "rowitem" }, ta, removeBtn("Remove fact"));
    (li as any).ne = f.ne ?? ""; // keeps the Nepali version of an existing fact
    return li;
  }
  function sourceRow(s: { title: string; url: string } = { title: "", url: "" }) {
    return el("li", { className: "rowitem source" },
      el("input", { value: s.title, placeholder: "Source name, e.g. Britannica", ariaLabel: "Source name" }),
      el("input", { value: s.url, type: "url", placeholder: "https://…", ariaLabel: "Source link" }),
      removeBtn("Remove source"));
  }
  function removeBtn(label: string) {
    const b = el("button", { type: "button", className: "x", ariaLabel: label, title: label }, "×");
    b.addEventListener("click", () => { b.closest("li")?.remove(); dirty = true; });
    return b;
  }
  $("#add-fact").addEventListener("click", () => { const r = factRow(); $("#facts").append(r); r.querySelector("textarea")!.focus(); });
  $("#add-source").addEventListener("click", () => { const r = sourceRow(); $("#sources").append(r); r.querySelector("input")!.focus(); });

  function openEditor(v: Entry | null) {
    editing = v;
    form.reset();
    const d: Entry = v ?? ({ number: Math.max(0, ...videos.map((x) => x.number)) + 1, date: todayNepal(), titleEn: "", slug: "" } as Entry);
    for (const k of ["titleEn", "titleNe", "number", "date", "descriptionEn", "description", "slug", "art", "tiktokUrl", "instagramUrl", "facebookUrl"]) {
      const f = field(k);
      if (f) f.value = d[k] ?? "";
    }
    field("youtubeId")!.value = d.youtubeId ? `https://youtube.com/shorts/${d.youtubeId}` : "";
    field("matchTitle")!.value = (d.matchTitle ?? []).join(", ");
    form.querySelectorAll<HTMLInputElement>("input[name=topic]").forEach((r) => (r.checked = r.value === d.topic));
    $("#facts").replaceChildren(...(d.facts ?? []).map(factRow));
    $("#sources").replaceChildren(...(d.sources ?? []).map(sourceRow));
    $("#edit-h").textContent = v ? `Edit video #${v.number}` : "New video";
    $("#delete").hidden = !v;
    $("#save-msg").textContent = "";
    $("#import-msg").textContent = "";
    (form.querySelector("details") as HTMLDetailsElement).open = false;
    dirty = false;
    show("edit");
  }

  // ---- import from the video's production MD file ("10 MD Files/NN - Name.md") ----
  const norm = (s = "") => cleanTitle(s).toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();
  // the same video may already be on the site, e.g. added by the daily YouTube save: match by number, then by English title
  function existingFor(md: ReturnType<typeof parseVideoMd>) {
    const en = norm(md.titleEn.split("|").pop());
    return videos.find((x) => md.number && x.number === md.number) ?? videos.find((x) => en.length > 8 && norm(`${x.titleEn} ${x.titleNe}`).includes(en));
  }
  async function importMd(file: File) {
    const msg = $("#import-msg");
    const fail = (t: string) => { msg.className = "msg err"; msg.textContent = t; };
    if (!/\.(md|markdown|txt)$/i.test(file.name)) return fail(`“${file.name}” isn't an .md file. Pick the video's file from “10 MD Files”.`);
    const md = parseVideoMd(await file.text());
    if (!md.facts.length && !md.sources.length) return fail(`“${file.name}” doesn't look like a video file: it has no “## Facts” or “## Sources”.`);

    let note = "";
    if (!editing) {
      const ex = existingFor(md);
      if (ex) {
        openEditor(ex);
        note = ` Video #${ex.number} was already on the site, so the file filled in that entry instead of making a copy.`;
      }
    } else if (md.number && editing.number !== md.number && !confirm(`This file is for video #${md.number}, but you're editing #${editing.number}. Fill it in anyway?`)) return;
    const had = $("#facts").children.length + $("#sources").children.length;
    if (had && !confirm("Replace the facts and sources already in this form with the ones from the file?")) return;

    const set = (k: string, v: string | number | undefined) => { const f = field(k); if (f && v !== undefined && v !== "") f.value = String(v); };
    set("titleEn", md.titleEn);
    set("titleNe", md.titleNe);
    set("descriptionEn", md.descriptionEn);
    set("description", md.description);
    if (!editing) set("number", md.number);
    if (md.topicFromFile || !form.querySelector("input[name=topic]:checked"))
      form.querySelectorAll<HTMLInputElement>("input[name=topic]").forEach((r) => (r.checked = r.value === md.topic));
    $("#facts").replaceChildren(...md.facts.map(factRow));
    $("#sources").replaceChildren(...md.sources.map(sourceRow));
    dirty = true;

    const left = md.skipped.length ? ` Left out ${md.skipped.length} note${md.skipped.length === 1 ? "" : "s"} that ${md.skipped.length === 1 ? "isn't a fact" : "aren't facts"} (“Imagination…”, “Background…”).` : "";
    msg.className = "msg ok";
    msg.textContent = `Filled in from “${file.name}”: ${md.facts.length} facts, ${md.sources.length} sources.${left}${note} Now check the topic, paste the app links and press Save.${md.warnings.length ? "\nHeads up: " + md.warnings.join(" ") : ""}`;
  }
  const picker = $<HTMLInputElement>("#md-file");
  picker.addEventListener("change", () => {
    const f = picker.files?.[0];
    picker.value = ""; // picking the same file again still fires
    if (f) importMd(f);
  });
  // drop a .md file on the list (starts a new video) or on the form
  const canDrop = () => !$("#list").hidden || !$("#edit").hidden;
  addEventListener("dragover", (e) => {
    if (!canDrop() || !e.dataTransfer?.types.includes("Files")) return;
    e.preventDefault();
    document.body.classList.add("dropping");
  });
  addEventListener("dragleave", (e) => { if (!e.relatedTarget) document.body.classList.remove("dropping"); });
  addEventListener("drop", (e) => {
    document.body.classList.remove("dropping");
    const f = e.dataTransfer?.files?.[0];
    if (!canDrop() || !f) return;
    e.preventDefault();
    if (!$("#list").hidden) openEditor(null);
    importMd(f);
  });
  // tidy pasted app links right away, so what you see is what gets saved
  for (const k of ["tiktokUrl", "instagramUrl", "facebookUrl"]) field(k)?.addEventListener("change", (e) => {
    const i = e.target as HTMLInputElement;
    i.value = cleanLink(i.value);
  });
  form.addEventListener("input", () => (dirty = true));
  $("#back").addEventListener("click", () => {
    if (dirty && !confirm("You have unsaved changes. Leave without saving?")) return;
    dirty = false;
    renderList();
    show("list");
  });
  addEventListener("beforeunload", (e) => { if (dirty) e.preventDefault(); });

  function readForm(): Entry | string {
    const val = (k: string) => field(k)?.value.trim() ?? "";
    const titleEn = val("titleEn");
    const number = Number(val("number"));
    const topic = (form.querySelector("input[name=topic]:checked") as HTMLInputElement | null)?.value;
    if (!titleEn) return "Add a title.";
    if (!Number.isInteger(number) || number < 1) return "Add a video number (1, 2, 3…).";
    if (!topic) return "Pick a topic.";
    const taken = videos.some((x) => x !== editing && x.number === number);
    if (taken) return `Video #${number} already exists. Use another number.`;
    const sources = [...$("#sources").children].map((li) => {
      const [t, l] = li.querySelectorAll("input");
      return { title: t.value.trim(), url: l.value.trim() };
    }).filter((s) => s.title || s.url);
    if (sources.some((s) => !s.title || !/^https?:\/\//.test(s.url))) return "Each source needs a name and a link starting with https://";
    let slug = val("slug") || slugify(titleEn) || `video-${number}`;
    if (videos.some((x) => x !== editing && x.slug === slug)) slug = `${slug}-${number}`;
    const keywords = val("matchTitle").split(",").map((s) => s.trim()).filter(Boolean);
    const next: Entry = {
      ...(editing ?? {}), // keeps any field this form doesn't show
      slug, number, titleNe: val("titleNe"), titleEn, date: val("date"), topic,
      youtubeId: ytId(val("youtubeId")), tiktokUrl: cleanLink(val("tiktokUrl")), instagramUrl: cleanLink(val("instagramUrl")), facebookUrl: cleanLink(val("facebookUrl")),
      description: val("description"), descriptionEn: val("descriptionEn"),
      facts: [...$("#facts").children].map((li) => ({ ne: (li as any).ne ?? "", en: li.querySelector("textarea")!.value.trim() })).filter((f) => f.en || f.ne),
      sources,
    };
    if (val("art")) next.art = val("art"); else delete next.art;
    if (keywords.length) next.matchTitle = keywords; else delete next.matchTitle;
    return next;
  }

  async function run(work: () => Promise<void>, done: string) {
    const btn = $<HTMLButtonElement>("#save"), msg = $("#save-msg");
    btn.disabled = true;
    msg.className = "msg";
    msg.textContent = "Saving…";
    try {
      await work();
      dirty = false;
      renderList();
      show("list");
      $("#list-msg").textContent = done;
    } catch (e: any) {
      msg.className = "msg err";
      msg.textContent = e.conflict ? "Someone else saved at the same moment. Press Save again." : e instanceof GhError ? e.message : "Couldn't reach GitHub. Check your internet and press Save again.";
    } finally {
      btn.disabled = false;
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const next = readForm();
    if (typeof next === "string") {
      $("#save-msg").className = "msg err";
      $("#save-msg").textContent = next;
      return;
    }
    const was = editing;
    run(() => commit((list) => {
      const i = was ? list.findIndex((x) => x.slug === was.slug) : -1;
      if (i >= 0) list[i] = next; else list.push(next);
      return list;
    }, `${was ? "Update" : "Add"} video #${next.number}: ${next.titleEn}`),
    `Saved “${next.titleEn}”. It's live on the site in about a minute.`);
  });

  $("#delete").addEventListener("click", () => {
    const v = editing;
    if (!v || !confirm(`Delete “${v.titleEn}” from the website?\n\nIt disappears from the site in about a minute. GitHub keeps the old version in its history.`)) return;
    run(() => commit((list) => list.filter((x) => x.slug !== v.slug), `Delete video #${v.number}: ${v.titleEn}`), `Deleted “${v.titleEn}”.`);
  });

  // ---- website stats: Vercel Web Analytics API, called from the browser with the owner's Vercel token ----
  const V = "https://api.vercel.com";
  const VKEY = "thaha-vercel-token";
  const VPROJ = "thaha-vercel-project"; // { projectId, teamId? }, found once from the project name
  const PROJECT = "thahathiyo";
  const ls = {
    get: (k: string) => { try { return localStorage.getItem(k) ?? ""; } catch { return ""; } },
    set: (k: string, v: string) => { try { v ? localStorage.setItem(k, v) : localStorage.removeItem(k); } catch {} },
  };
  class VcError extends Error {}
  let days = 7;
  let statsFor = ""; // "7" / "30" once loaded, so switching tabs doesn't refetch

  async function vget(path: string, params: Record<string, string | number> = {}, soft = false) {
    const q = new URLSearchParams(Object.entries(params).map(([k, v]) => [k, String(v)]));
    const res = await fetch(`${V}${path}${q.size ? "?" + q : ""}`, { headers: { Authorization: `Bearer ${ls.get(VKEY)}` }, cache: "no-store" });
    if (res.status === 401) throw new VcError("Vercel didn't accept that token. It may be mistyped or expired: create a new one.");
    if (soft && (res.status === 403 || res.status === 404)) return null;
    if (!res.ok) {
      const msg = (await res.json().catch(() => null))?.error?.message;
      throw new VcError(msg ? `Vercel said: “${msg}”` : `Vercel said “${res.status} ${res.statusText}”. Try again in a minute.`);
    }
    return res.json();
  }
  // Personal projects need no teamId; team projects (including Hobby's default team) do, so try each team.
  async function project(): Promise<{ projectId: string; teamId?: string }> {
    try { const c = JSON.parse(ls.get(VPROJ)); if (c?.projectId) return c; } catch {}
    let found: { projectId: string; teamId?: string } | null = null;
    const own = await vget(`/v9/projects/${PROJECT}`, {}, true);
    if (own) found = { projectId: own.id };
    else {
      for (const t of (await vget("/v2/teams", {}, true))?.teams ?? []) {
        const p = await vget(`/v9/projects/${PROJECT}`, { teamId: t.id }, true);
        if (p) { found = { projectId: p.id, teamId: t.id }; break; }
      }
    }
    if (!found) throw new VcError(`This token can't see a Vercel project called “${PROJECT}”. Make a token whose scope includes that project.`);
    ls.set(VPROJ, JSON.stringify(found));
    return found;
  }
  async function visits(params: Record<string, string | number>) {
    const p = await project();
    return (await vget("/v1/query/web-analytics/visits/aggregate", { ...p, ...params })).data;
  }

  const fmt = (n: number) => (n ?? 0).toLocaleString("en");
  const isoDay = (d: Date) => d.toISOString().slice(0, 10);
  const regions = (() => { try { return new Intl.DisplayNames(["en"], { type: "region" }); } catch { return null; } })();
  const pageName = (path: string) => {
    if (!path || path === "/") return "Homepage";
    const slug = path.match(/^\/videos\/([^/]+)\/?$/)?.[1];
    const v = slug && videos.find((x) => x.slug === slug);
    return v ? v.titleEn || v.titleNe : path;
  };
  const label = {
    requestPath: pageName,
    referrerHostname: (h: string) => (h ? h.replace(/^www\./, "") : "Direct or unknown"),
    country: (c: string) => (c ? regions?.of(c) ?? c : "Unknown"),
    deviceType: (d: string) => (d ? d[0].toUpperCase() + d.slice(1) : "Unknown"),
  } as Record<string, (v: string) => string>;

  function rank(id: string, by: string, rows: any[]) {
    const ol = $("#" + id);
    const items = (rows ?? []).filter((r) => r.pageviews > 0);
    const max = Math.max(1, ...items.map((r) => r.pageviews));
    ol.replaceChildren(...(items.length ? items.map((r) => {
      const bar = el("span", { className: "rank-bar" });
      bar.style.width = `${(r.pageviews / max) * 100}%`;
      return el("li", {}, el("span", { className: "rank-name" }, label[by](r[by] ?? "")), el("span", { className: "rank-n" }, fmt(r.pageviews)), bar);
    }) : [el("li", { className: "empty" }, "No visits yet in this range")]));
  }

  function chart(rows: any[], since: Date) {
    const byDay = new Map((rows ?? []).map((r) => [String(r.timestamp).slice(0, 10), r]));
    const series = Array.from({ length: days }, (_, i) => {
      const d = new Date(since.getTime() + i * 86400000);
      const r = byDay.get(isoDay(d));
      return { day: d, views: r?.pageviews ?? 0, visitors: r?.visitors ?? 0 };
    });
    const max = Math.max(1, ...series.map((s) => s.views));
    const nice = (d: Date) => d.toLocaleDateString("en", { day: "numeric", month: "short", timeZone: "UTC" });
    const tip = $("#tip");
    $("#ymax").textContent = `${fmt(max)} views`;
    $("#daily").replaceChildren(...series.map((s) => {
      const text = `${nice(s.day)}: ${fmt(s.views)} page views, ${fmt(s.visitors)} visitors`;
      const col = el("span", { className: "col", tabIndex: 0, role: "img", ariaLabel: text });
      const bar = el("span", { className: "bar" });
      bar.style.height = s.views ? `${Math.max(2, (s.views / max) * 100)}%` : "0";
      col.append(bar);
      const on = () => {
        tip.textContent = text;
        tip.hidden = false;
        const box = col.parentElement!.getBoundingClientRect(), c = col.getBoundingClientRect();
        tip.style.left = `${Math.min(Math.max(c.left - box.left + c.width / 2, 90), box.width - 90)}px`;
      };
      col.addEventListener("pointerenter", on);
      col.addEventListener("focus", on);
      col.addEventListener("pointerleave", () => (tip.hidden = true));
      col.addEventListener("blur", () => (tip.hidden = true));
      return col;
    }));
    const mid = series[Math.floor(series.length / 2)].day;
    $("#xlabels").replaceChildren(...[series[0].day, mid, series[series.length - 1].day].map((d) => el("span", {}, nice(d))));
    $("#daily-table").replaceChildren(...series.map((s) => el("tr", {}, el("td", {}, nice(s.day)), el("td", {}, fmt(s.views)), el("td", {}, fmt(s.visitors)))));
    return series;
  }

  async function loadStats(force = false) {
    const connected = !!ls.get(VKEY);
    $("#vc-connect").hidden = connected;
    $("#stats-body").hidden = !connected || !statsFor;
    if (!connected || (!force && statsFor === String(days))) return;
    const msg = $("#stats-msg");
    msg.className = "msg";
    msg.textContent = "Loading stats…";
    const until = new Date(todayNepal() + "T00:00:00Z");
    const since = new Date(until.getTime() - (days - 1) * 86400000);
    const range = { since: isoDay(since), until: isoDay(until) };
    try {
      const [daily, total, pages, refs, countries, devices] = await Promise.all([
        visits({ ...range, by: "day" }),
        visits(range).catch(() => null), // a total without grouping; summed from days if Vercel needs a group
        visits({ ...range, by: "requestPath", limit: 8 }),
        visits({ ...range, by: "referrerHostname", limit: 6 }),
        visits({ ...range, by: "country", limit: 6 }),
        visits({ ...range, by: "deviceType", limit: 4 }),
      ]);
      const series = chart(daily, since);
      const t = Array.isArray(total) ? total[0] : total;
      const sum = (k: "views" | "visitors") => series.reduce((a, s) => a + s[k], 0);
      $("#t-views").textContent = fmt(t?.pageviews ?? sum("views"));
      $("#t-visitors").textContent = fmt(t?.visitors ?? sum("visitors"));
      $("#t-visitors-l").textContent = t ? "Visitors" : "Visitors (daily, added up)";
      const top = (refs ?? []).find((r: any) => r.pageviews > 0);
      $("#t-source").textContent = top ? label.referrerHostname(top.referrerHostname) : "–";
      rank("r-pages", "requestPath", pages);
      rank("r-refs", "referrerHostname", refs);
      rank("r-countries", "country", countries);
      rank("r-devices", "deviceType", devices);
      statsFor = String(days);
      msg.textContent = "";
      $("#stats-body").hidden = false;
    } catch (e: any) {
      msg.className = "msg err";
      msg.textContent = e instanceof VcError ? e.message : "Couldn't reach Vercel. Check your internet and try again.";
    }
  }

  document.querySelectorAll<HTMLElement>(".tab").forEach((t) => t.addEventListener("click", () => {
    if (!$("#edit").hidden && dirty && !confirm("You have unsaved changes. Leave without saving?")) return;
    dirty = false;
    if (t.dataset.tab === "stats") {
      show("stats");
      loadStats();
    } else {
      renderList();
      show("list");
    }
  }));
  document.querySelectorAll<HTMLButtonElement>(".range-btn").forEach((b) => b.addEventListener("click", () => {
    days = Number(b.dataset.days);
    document.querySelectorAll(".range-btn").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    loadStats();
  }));
  $("#vc-form").addEventListener("submit", (e) => {
    e.preventDefault();
    ls.set(VKEY, $<HTMLInputElement>("#vc-token").value.trim());
    ls.set(VPROJ, "");
    statsFor = "";
    loadStats(true).then(() => {
      if (!$("#stats-body").hidden) return;
      ls.set(VKEY, ""); // didn't work: forget it and show the connect steps again, with the error above them
      $("#vc-connect").hidden = false;
    });
  });
  $("#vc-disconnect").addEventListener("click", () => {
    ls.set(VKEY, "");
    ls.set(VPROJ, "");
    statsFor = "";
    $<HTMLInputElement>("#vc-token").value = "";
    loadStats();
  });

  start();
</script>

