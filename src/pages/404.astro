---
import Base from "../layouts/Base.astro";
import { MascotBurst } from "../components/art/scenes";
import { u } from "../lib/url";
import T from "../components/T.astro";
---
<Base title="Page not found" description="This page could not be found." noindex>
  <section class="wrap section nf">
    <div class="art"><MascotBurst mood="shock" label="Thaha looking surprised" /></div>
    <div>
      <p class="code">404</p>
      <h1><T ne="यो पेज त थाहा थिएन!" en="Hmm, even Thaha doesn't know this page." mix="यो page त थाहालाई पनि थाहा थिएन!" /></h1>
      <p><T ne="लिङ्क पुरानो वा गलत हुन सक्छ।" en="The link may be old or mistyped." mix="Link पुरानो वा typo भएको हुन सक्छ।" /></p>
      <p class="actions">
        <a class="btn" href={u("")}><T ne="गृहपृष्ठ" en="Home" mix="Home" /></a>
        <a class="btn ghost" href={u("#videos")}><T ne="सबै भिडियो" en="All videos" mix="सबै Videos" /></a>
      </p>
    </div>
  </section>
</Base>
<style>
  .nf {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .art {
    max-width: 320px;
  }
  @media (min-width: 760px) {
    .nf {
      grid-template-columns: 320px 1fr;
      gap: 48px;
    }
  }
  .code {
    font-size: 4rem;
    font-weight: 800;
    color: var(--vermilion);
    margin: 0;
    line-height: 1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
