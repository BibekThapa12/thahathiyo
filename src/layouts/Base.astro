---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import { CHANNEL, SOCIALS } from "../data/site";
import { abs, u } from "../lib/url";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "video.other";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image = "og/default.png", type = "website", jsonLd, noindex } = Astro.props;
const site = Astro.site;
const canonical = new URL(Astro.url.pathname, site ?? Astro.url).href;
const isHome = Astro.url.pathname === u("");
// Arriving on the home page: the old page lifts away, home rises in. Other pages keep Astro's crossfade.
const homeRise = {
  forwards: {
    old: { name: "page-out", duration: "160ms", easing: "ease-in", fillMode: "both" },
    new: { name: "home-rise", duration: "520ms", easing: "cubic-bezier(0.23, 1, 0.32, 1)", fillMode: "both" },
  },
};
const mainAnim = isHome ? { ...homeRise, backwards: homeRise.forwards } : "fade";
const fullTitle = title.includes("थाहा थियो?") ? title : `${title} | ${CHANNEL.display}`;
const ogImage = abs(image, site);
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: CHANNEL.display,
  alternateName: ["थाहा थियो?", "Thaha Thiyo", CHANNEL.handle],
  url: abs("", site),
  logo: abs("icon-512.png", site),
  sameAs: SOCIALS.map((s) => s.url),
};
const ld = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1F2A6B" />
    <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u("apple-touch-icon.png")} />
    <link rel="manifest" href={u("site.webmanifest")} />
    <link rel="sitemap" href={u("sitemap-index.xml")} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <meta property="og:site_name" content={CHANNEL.display} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <ClientRouter />
    <script is:inline>
      // Owner's visits don't count: /admin marks the browser on sign-in, and analytics drops its events.
      // Queued for Vercel's script, which replays window.vaq when it loads.
      window.va = window.va || function (...a) { (window.vaq = window.vaq || []).push(a); };
      window.va("beforeSend", (e) => { try { return localStorage.getItem("thaha-no-track") ? null : e; } catch { return e; } });
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main"><T ne="मुख्य सामग्रीमा जानुहोस्" en="Skip to content" mix="Main content मा जानुहोस्" /></a>
    <Header />
    <main id="main" transition:name="page" transition:animate={mainAnim}>
      <slot />
    </main>
    <Footer />
    <script>
      // Back home after a page switch: the mascot logo gives a small hop, as if saying hello again.
      document.addEventListener("astro:after-swap", () => {
        if (location.pathname !== import.meta.env.BASE_URL || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const o = "50% 90%";
        document.querySelector(".site-header .brand svg")?.animate(
          [
            { transform: "none", transformOrigin: o },
            { transform: "translateY(-7px) rotate(-10deg)", transformOrigin: o, offset: 0.35 },
            { transform: "translateY(0) rotate(6deg)", transformOrigin: o, offset: 0.7 },
            { transform: "none", transformOrigin: o },
          ],
          { duration: 620, delay: 140, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
        );
      });
    </script>
    <script>
      // Cursor flow: small gold/red dots fall away from the pointer and fade. Mouse only, never with reduced motion.
      // One window listener (bundled module, runs once); dots live on <body>, so page swaps simply drop them.
      if (matchMedia("(hover: hover) and (pointer: fine)").matches && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        let last = 0;
        let red = false;
        addEventListener("pointermove", (e) => {
          if (e.pointerType !== "mouse" || e.timeStamp - last < 45) return;
          last = e.timeStamp;
          const dot = document.createElement("span");
          dot.className = (red = !red) ? "trail red" : "trail";
          document.body.append(dot);
          const from = `translate(${e.clientX}px, ${e.clientY}px)`;
          dot.animate(
            [
              { transform: `${from} scale(1)`, opacity: 0.85 },
              { transform: `translate(${e.clientX + (Math.random() * 16 - 8)}px, ${e.clientY + 22}px) scale(0.3)`, opacity: 0 },
            ],
            { duration: 650, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
          ).onfinish = () => dot.remove();
        }, { passive: true });
      }
    </script>
  </body>
</html>
